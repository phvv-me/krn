"""The part of MLX that the Apple experiments and the device probe call. MLX is a compiled extension without types."""

from collections.abc import Buffer

class array:
    def __init__(self, data: Buffer) -> None: ...

def device_info() -> dict[str, str | int]: ...
def eval(*arrays: array) -> None: ...
def synchronize() -> None: ...
def matmul(a: array, b: array) -> array: ...
def softmax(a: array, axis: int = -1) -> array: ...
