import ctypes

ZES_STRUCTURE_TYPE_DEVICE_PROPERTIES: int
ZES_STRUCTURE_TYPE_PCI_PROPERTIES: int
class zes_driver_handle_t(ctypes.c_void_p): ...
class zes_device_handle_t(ctypes.c_void_p): ...
class zes_temp_handle_t(ctypes.c_void_p): ...
class zes_pwr_handle_t(ctypes.c_void_p): ...
class CoreProperties(ctypes.Structure):
    name: bytes
    numSlices: int
    numSubslicesPerSlice: int
    numEUsPerSubslice: int
class zes_device_properties_t(ctypes.Structure):
    stype: int
    core: CoreProperties
class PCIAddress(ctypes.Structure):
    domain: int
    bus: int
    device: int
    function: int
class zes_pci_properties_t(ctypes.Structure):
    stype: int
    address: PCIAddress

def zesInit(flags: int) -> int: ...
def zesDriverGet(count: ctypes._Pointer[ctypes.c_uint32], handles: ctypes.Array[ctypes.c_void_p] | None) -> int: ...
def zesDeviceGet(driver: ctypes.c_void_p, count: ctypes._Pointer[ctypes.c_uint32], handles: ctypes.Array[ctypes.c_void_p] | None) -> int: ...
def zesDeviceEnumTemperatureSensors(device: ctypes.c_void_p, count: ctypes._Pointer[ctypes.c_uint32], handles: ctypes.Array[ctypes.c_void_p] | None) -> int: ...
def zesDeviceEnumPowerDomains(device: ctypes.c_void_p, count: ctypes._Pointer[ctypes.c_uint32], handles: ctypes.Array[ctypes.c_void_p] | None) -> int: ...
def zesTemperatureGetState(handle: ctypes.c_void_p, temperature: ctypes._Pointer[ctypes.c_double]) -> int: ...
def zesPowerGetUsage(handle: ctypes.c_void_p, instant: ctypes._Pointer[ctypes.c_uint32], average: ctypes._Pointer[ctypes.c_uint32]) -> int: ...
def zesDeviceGetProperties(handle: ctypes.c_void_p, properties: ctypes._Pointer[zes_device_properties_t]) -> int: ...
def zesDevicePciGetProperties(handle: ctypes.c_void_p, properties: ctypes._Pointer[zes_pci_properties_t]) -> int: ...
