"""The subset of `cuda.bindings.nvrtc` (cuda-bindings 13.4) that the CUDA backend calls. Every call returns the status
first and then its results; the buffers are filled in place."""

from enum import IntEnum

class nvrtcResult(IntEnum):
    NVRTC_SUCCESS = 0

class nvrtcProgram: ...

def nvrtcCreateProgram(
    source: bytes, name: bytes, header_count: int, headers: list[bytes], header_names: list[bytes]
) -> tuple[nvrtcResult, nvrtcProgram]: ...
def nvrtcCompileProgram(program: nvrtcProgram, option_count: int, options: list[bytes]) -> tuple[nvrtcResult]: ...
def nvrtcGetProgramLogSize(program: nvrtcProgram) -> tuple[nvrtcResult, int]: ...
def nvrtcGetProgramLog(program: nvrtcProgram, log: bytearray) -> tuple[nvrtcResult]: ...
def nvrtcGetCUBINSize(program: nvrtcProgram) -> tuple[nvrtcResult, int]: ...
def nvrtcGetCUBIN(program: nvrtcProgram, cubin: bytearray) -> tuple[nvrtcResult]: ...
def nvrtcDestroyProgram(program: nvrtcProgram) -> tuple[nvrtcResult]: ...
def nvrtcVersion() -> tuple[nvrtcResult, int, int]: ...
