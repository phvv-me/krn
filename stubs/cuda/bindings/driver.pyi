"""The subset of `cuda.bindings.driver` (cuda-bindings 13.4) that the CUDA backend calls. Every call returns the status
first and then its results."""

from enum import IntEnum

class CUresult(IntEnum):
    CUDA_SUCCESS = 0
    CUDA_ERROR_INVALID_VALUE = 1
    CUDA_ERROR_COOPERATIVE_LAUNCH_TOO_LARGE = 720

class CUstreamCaptureStatus(IntEnum):
    CU_STREAM_CAPTURE_STATUS_NONE = 0
    CU_STREAM_CAPTURE_STATUS_ACTIVE = 1
    CU_STREAM_CAPTURE_STATUS_INVALIDATED = 2

class CUstreamCaptureMode(IntEnum):
    CU_STREAM_CAPTURE_MODE_GLOBAL = 0
    CU_STREAM_CAPTURE_MODE_THREAD_LOCAL = 1
    CU_STREAM_CAPTURE_MODE_RELAXED = 2

class CUfunction_attribute(IntEnum):
    CU_FUNC_ATTRIBUTE_MAX_DYNAMIC_SHARED_SIZE_BYTES = 8

class CUdevice_attribute(IntEnum):
    CU_DEVICE_ATTRIBUTE_L2_CACHE_SIZE = 38

class CUstream:
    def __int__(self) -> int: ...

class CUkernel: ...
class CUfunction: ...
class CUgraph: ...
class CUgraphExec: ...

class CUdevice:
    def __init__(self, ordinal: int = 0) -> None: ...

def cuGetErrorName(error: CUresult) -> tuple[CUresult, bytes | None]: ...
def cuGetErrorString(error: CUresult) -> tuple[CUresult, bytes | None]: ...
def cuMemcpyHtoDAsync(dst: int, src: int, size: int, stream: CUstream) -> tuple[CUresult]: ...
def cuMemcpyDtoHAsync(dst: int, src: int, size: int, stream: CUstream) -> tuple[CUresult]: ...
def cuLaunchKernel(
    kernel: CUkernel, grid_x: int, grid_y: int, grid_z: int, block_x: int, block_y: int, block_z: int,
    shared: int, stream: CUstream, parameters: int, extra: int,
) -> tuple[CUresult]: ...  # fmt: skip
def cuLaunchCooperativeKernel(
    kernel: CUkernel, grid_x: int, grid_y: int, grid_z: int, block_x: int, block_y: int, block_z: int,
    shared: int, stream: CUstream, parameters: int,
) -> tuple[CUresult]: ...  # fmt: skip
def cuKernelGetFunction(kernel: CUkernel) -> tuple[CUresult, CUfunction]: ...
def cuOccupancyMaxActiveBlocksPerMultiprocessor(
    function: CUfunction, block_size: int, dynamic_shared_bytes: int
) -> tuple[CUresult, int]: ...
def cuKernelSetAttribute(
    attribute: CUfunction_attribute, value: int, kernel: CUkernel, device: CUdevice
) -> tuple[CUresult]: ...
def cuStreamIsCapturing(stream: CUstream) -> tuple[CUresult, CUstreamCaptureStatus]: ...
def cuStreamBeginCapture(stream: CUstream, mode: CUstreamCaptureMode) -> tuple[CUresult]: ...
def cuStreamEndCapture(stream: CUstream) -> tuple[CUresult, CUgraph]: ...
def cuGraphInstantiate(graph: CUgraph, flags: int) -> tuple[CUresult, CUgraphExec]: ...
def cuGraphLaunch(executable: CUgraphExec, stream: CUstream) -> tuple[CUresult]: ...
def cuGraphExecDestroy(executable: CUgraphExec) -> tuple[CUresult]: ...
def cuGraphDestroy(graph: CUgraph) -> tuple[CUresult]: ...

class CUcontext:
    def __int__(self) -> int: ...

def cuInit(flags: int) -> tuple[CUresult]: ...
def cuDeviceGetCount() -> tuple[CUresult, int]: ...
def cuCtxGetCurrent() -> tuple[CUresult, CUcontext]: ...
def cuDriverGetVersion() -> tuple[CUresult, int]: ...
def cuDeviceGetAttribute(attribute: CUdevice_attribute, device: int) -> tuple[CUresult, int]: ...
def cuThreadExchangeStreamCaptureMode(mode: CUstreamCaptureMode) -> tuple[CUresult, CUstreamCaptureMode]: ...
def cuStreamSynchronize(stream: int) -> tuple[CUresult]: ...
