"""The subset of `cuda.core` (cuda-core 1.2) that the CUDA backend uses."""

from typing import NamedTuple

from cuda.bindings.driver import CUkernel, CUstream

class ComputeCapability(NamedTuple):
    major: int
    minor: int

class DeviceProperties:
    warp_size: int
    max_threads_per_multiprocessor: int
    max_threads_per_block: int
    max_shared_memory_per_block: int
    max_registers_per_block: int
    clock_rate: int
    integrated: bool
    cooperative_launch: bool
    multiprocessor_count: int

class Buffer:
    @property
    def handle(self) -> int: ...
    @property
    def size(self) -> int: ...

class EventOptions:
    def __init__(
        self, timing_enabled: bool | None = False, blocking_sync: bool | None = False, ipc_enabled: bool | None = False
    ) -> None: ...

class Event:
    @property
    def is_done(self) -> bool: ...
    def sync(self) -> None: ...
    def __sub__(self, other: Event) -> float: ...

class Stream:
    @property
    def handle(self) -> CUstream: ...
    def record(self, event: Event | None = None, options: EventOptions | None = None) -> Event: ...
    def wait(self, event_or_stream: Event | Stream) -> None: ...
    def sync(self) -> None: ...

class Device:
    uuid: str
    pci_bus_id: str
    arch: str
    def __init__(self, device_id: int | None = None) -> None: ...
    @property
    def name(self) -> str: ...
    @property
    def compute_capability(self) -> ComputeCapability: ...
    @property
    def properties(self) -> DeviceProperties: ...
    def set_current(self) -> None: ...
    def create_stream(self) -> Stream: ...
    def allocate(self, size: int, *, stream: Stream) -> Buffer: ...
    def sync(self) -> None: ...

class KernelOccupancy:
    def max_active_blocks_per_multiprocessor(self, block_size: int, dynamic_shared_memory_size: int) -> int: ...

class Kernel:
    @property
    def occupancy(self) -> KernelOccupancy: ...
    @property
    def handle(self) -> CUkernel: ...

class ObjectCode:
    @classmethod
    def from_cubin(cls, module: bytes, *, name: str = "") -> ObjectCode: ...
    def get_kernel(self, name: str) -> Kernel: ...
