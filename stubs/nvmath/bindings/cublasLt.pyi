"""Used declarations from nvmath-python 1.0.0; callable signatures from the adjacent NVIDIA .pxd."""

from enum import IntEnum

class Epilogue(IntEnum):
    DEFAULT = ...
    BIAS = ...
    RELU = ...
    GELU = ...
    RELU_BIAS = ...
    GELU_BIAS = ...

class MatmulDescAttribute(IntEnum):
    EPILOGUE = ...
    BIAS_DATA_TYPE = ...
    BIAS_POINTER = ...
    SM_COUNT_TARGET = ...

class MatmulPreferenceAttribute(IntEnum):
    MAX_WORKSPACE_BYTES = ...
    MIN_ALIGNMENT_A_BYTES = ...
    MIN_ALIGNMENT_B_BYTES = ...
    MIN_ALIGNMENT_C_BYTES = ...
    MIN_ALIGNMENT_D_BYTES = ...
    REDUCTION_SCHEME_MASK = ...

class ReductionScheme(IntEnum):
    NONE = ...

def create() -> int: ...
def destroy(light_handle: int) -> None: ...
def get_version() -> int: ...
def matmul(
    light_handle: int,
    compute_desc: int,
    alpha: int,
    a: int,
    adesc: int,
    b: int,
    bdesc: int,
    beta: int,
    c: int,
    cdesc: int,
    d: int,
    ddesc: int,
    algo: int,
    workspace: int,
    workspace_size_in_bytes: int,
    stream: int,
) -> None: ...
def matrix_layout_create(type: int, rows: int, cols: int, ld: int) -> int: ...
def matrix_layout_destroy(mat_layout: int) -> None: ...
def matmul_desc_create(compute_type: int, scale_type: int) -> int: ...
def matmul_desc_destroy(matmul_desc: int) -> None: ...
def matmul_desc_set_attribute(matmul_desc: int, attr: int, buf: int, size_in_bytes: int) -> None: ...
def matmul_preference_create() -> int: ...
def matmul_preference_destroy(pref: int) -> None: ...
