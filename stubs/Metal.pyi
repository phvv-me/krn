"""The part of PyObjC's Metal framework that `patos_proto.metal` and the Apple profiler call. PyObjC resolves its members at
run time, so the checkers cannot see them; `(value, error)` pairs are how PyObjC returns a method's out-parameters."""

from collections.abc import Buffer

from Foundation import NSRange

MTLResourceStorageModeShared: int
MTLStorageModeShared: int
MTLLanguageVersion3_2: int
MTLMathModeSafe: int
MTLMathFloatingPointFunctionsPrecise: int
MTLCaptureDestinationGPUTraceDocument: int
MTLCounterSamplingPointAtStageBoundary: int
MTLCounterSamplingPointAtDispatchBoundary: int
MTLCounterSamplingPointAtDrawBoundary: int
MTLCounterSamplingPointAtBlitBoundary: int

class NSError:
    def __str__(self) -> str: ...

class MTLSize:
    width: int
    height: int
    depth: int

def MTLSizeMake(width: int, height: int, depth: int) -> MTLSize: ...

class MTLCompileOptions:
    @classmethod
    def new(cls) -> MTLCompileOptions: ...
    def setLanguageVersion_(self, version: int) -> None: ...
    def setMathMode_(self, mode: int) -> None: ...
    def setMathFloatingPointFunctions_(self, functions: int) -> None: ...

class MTLFunction: ...

class MTLLibrary:
    def newFunctionWithName_(self, name: str) -> MTLFunction: ...

class MTLComputePipelineState:
    def threadExecutionWidth(self) -> int: ...
    def maxTotalThreadsPerThreadgroup(self) -> int: ...

class MTLSharedEvent: ...

class MTLBuffer:
    def contents(self) -> _Contents: ...

class _Contents:
    def as_buffer(self, length: int) -> Buffer: ...

class MTLCounter:
    def name(self) -> str: ...

class MTLCounterSet:
    def name(self) -> str: ...
    def counters(self) -> list[MTLCounter]: ...

class MTLCounterSampleBuffer:
    def resolveCounterRange_(self, window: NSRange) -> Buffer: ...

class MTLCounterSampleBufferDescriptor:
    @classmethod
    def alloc(cls) -> MTLCounterSampleBufferDescriptor: ...
    def init(self) -> MTLCounterSampleBufferDescriptor: ...
    def setCounterSet_(self, counter_set: MTLCounterSet) -> None: ...
    def setSampleCount_(self, count: int) -> None: ...
    def setStorageMode_(self, mode: int) -> None: ...

class MTLComputePassSampleBufferAttachmentDescriptor:
    def setSampleBuffer_(self, buffer: MTLCounterSampleBuffer) -> None: ...
    def setStartOfEncoderSampleIndex_(self, index: int) -> None: ...
    def setEndOfEncoderSampleIndex_(self, index: int) -> None: ...

class MTLComputePassSampleBufferAttachmentDescriptorArray:
    def objectAtIndexedSubscript_(self, index: int) -> MTLComputePassSampleBufferAttachmentDescriptor: ...

class MTLComputePassDescriptor:
    @classmethod
    def computePassDescriptor(cls) -> MTLComputePassDescriptor: ...
    def sampleBufferAttachments(self) -> MTLComputePassSampleBufferAttachmentDescriptorArray: ...

class MTLCaptureManager:
    @classmethod
    def sharedCaptureManager(cls) -> MTLCaptureManager: ...
    def supportsDestination_(self, destination: int) -> bool: ...

class MTLComputeCommandEncoder:
    def setComputePipelineState_(self, pipeline: MTLComputePipelineState) -> None: ...
    def setBuffer_offset_atIndex_(self, buffer: MTLBuffer, offset: int, index: int) -> None: ...
    def setBytes_length_atIndex_(self, data: bytes, length: int, index: int) -> None: ...
    def dispatchThreadgroups_threadsPerThreadgroup_(self, groups: MTLSize, threads: MTLSize) -> None: ...
    def endEncoding(self) -> None: ...

class MTLCommandBuffer:
    def encodeSignalEvent_value_(self, event: MTLSharedEvent, value: int) -> None: ...
    def encodeWaitForEvent_value_(self, event: MTLSharedEvent, value: int) -> None: ...
    def GPUStartTime(self) -> float: ...
    def GPUEndTime(self) -> float: ...
    def status(self) -> int: ...
    def computeCommandEncoder(self) -> MTLComputeCommandEncoder: ...
    def computeCommandEncoderWithDescriptor_(self, descriptor: MTLComputePassDescriptor) -> MTLComputeCommandEncoder: ...
    def commit(self) -> None: ...
    def waitUntilCompleted(self) -> None: ...
    def error(self) -> NSError | None: ...

class MTLCommandQueue:
    def commandBuffer(self) -> MTLCommandBuffer: ...

class MTLDevice:
    def newSharedEvent(self) -> MTLSharedEvent: ...
    def newBufferWithLength_options_(self, length: int, options: int) -> MTLBuffer | None: ...
    def registryID(self) -> int: ...
    def supportsFamily_(self, family: int) -> bool: ...
    def supportsCounterSampling_(self, point: int) -> bool: ...
    def counterSets(self) -> list[MTLCounterSet]: ...
    def sampleTimestamps_gpuTimestamp_(self, cpu: None, gpu: None) -> tuple[int, int]: ...
    def newCounterSampleBufferWithDescriptor_error_(
        self, descriptor: MTLCounterSampleBufferDescriptor, error: None
    ) -> tuple[MTLCounterSampleBuffer | None, NSError | None]: ...
    def recommendedMaxWorkingSetSize(self) -> int: ...
    def hasUnifiedMemory(self) -> bool: ...
    def maxThreadsPerThreadgroup(self) -> MTLSize: ...
    def maxThreadgroupMemoryLength(self) -> int: ...
    def currentAllocatedSize(self) -> int: ...
    def name(self) -> str: ...
    def newCommandQueue(self) -> MTLCommandQueue: ...
    def newLibraryWithSource_options_error_(
        self, source: str, options: MTLCompileOptions | None, error: None
    ) -> tuple[MTLLibrary | None, NSError | None]: ...
    def newComputePipelineStateWithFunction_error_(
        self, function: MTLFunction, error: None
    ) -> tuple[MTLComputePipelineState | None, NSError | None]: ...
    def newBufferWithBytes_length_options_(self, data: bytes, length: int, options: int) -> MTLBuffer: ...

def MTLCreateSystemDefaultDevice() -> MTLDevice | None: ...
def MTLCopyAllDevices() -> list[MTLDevice]: ...
