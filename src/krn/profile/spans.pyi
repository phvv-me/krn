from collections.abc import Callable, Coroutine
from types import TracebackType
from typing import overload

from .profiler import Profiler

type SpanToken = tuple[Profiler, int, int] | None

def active() -> Profiler | None: ...
def activate(session: Profiler) -> None: ...
def deactivate(session: Profiler) -> None: ...
def start(name: str) -> SpanToken: ...
def finish(token: SpanToken) -> None: ...

class Span:
    def __init__(self, name: str) -> None: ...
    def __call__[**P, R](self, func: Callable[P, R]) -> Callable[P, R]: ...
    def __enter__(self) -> Span: ...
    def __exit__(
        self,
        exc_type: type[BaseException] | None = None,
        exc: BaseException | None = None,
        traceback: TracebackType | None = None,
    ) -> None: ...

@overload
def span[**P, R](name: Callable[P, Coroutine[None, None, R]]) -> Callable[P, Coroutine[None, None, R]]: ...
@overload
def span[**P, R](name: Callable[P, R]) -> Callable[P, R]: ...
@overload
def span(name: str) -> Span: ...
